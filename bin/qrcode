#!/usr/bin/env ruby
require "optparse"
require_relative "../lib/qr_code_generator"

# ロケールが UTF-8 でない環境でも引数を UTF-8 として解釈する
ARGV.map! do |arg|
  arg.encoding == Encoding::UTF_8 ? arg : arg.dup.force_encoding(Encoding::UTF_8)
end

options = { module_size: 10, label: :auto }

parser = OptionParser.new do |opts|
  opts.banner = <<~BANNER
    QR コード生成ツール

    使い方: bin/qrcode [オプション]

    例:
      bin/qrcode --text "スターください" -o star.png
      bin/qrcode --url "https://github.com/yujiteshima" -o profile.svg
      bin/qrcode --url "https://github.com/yujiteshima/qrcode-generator" --text "スターください" -o star_repo.png
      bin/qrcode --text "スターください"          # ファイル指定なしでターミナルに表示

    --text を指定して画像出力すると、既定で QR コードの下にその文字列が表示されます
    (データとしての埋め込みとは別に、目で見える形でも描画されます)。
  BANNER

  opts.on("-t", "--text TEXT", "QR コードに埋め込む文字列") { |v| options[:text] = v }
  opts.on("-u", "--url URL", "QR コードに埋め込む URL") { |v| options[:url] = v }
  opts.on("-o", "--output FILE", "出力ファイル (.png / .svg)。省略時はターミナルに表示") { |v| options[:output] = v }
  opts.on("-s", "--size N", Integer, "PNG/SVG の 1 モジュールあたりのピクセル数 (既定: 10)") { |v| options[:module_size] = v }
  opts.on("-l", "--label TEXT", "画像の下に表示する文字列 (既定: --text の内容)") { |v| options[:label] = v }
  opts.on("--no-label", "画像下への文字列表示を行わない") { options[:label] = nil }
  opts.on("--font PATH", "PNG ラベル用フォントファイル (既定: 日本語フォントを自動検出)") { |v| options[:font] = v }
  opts.on("-h", "--help", "このヘルプを表示") do
    puts opts
    exit
  end
end

begin
  parser.parse!

  payload = QRCodeGenerator.build_payload(url: options[:url], text: options[:text])
  qr = QRCodeGenerator.generate(payload)
  label = options[:label] == :auto ? options[:text] : options[:label]

  if options[:output]
    QRCodeGenerator.write(qr, options[:output],
                          module_size: options[:module_size],
                          label: label,
                          font: options[:font])
    puts "QR コードを保存しました: #{options[:output]}"
    puts "画像内に表示した文字列: #{label}" if label && !label.strip.empty?
    puts "埋め込んだデータ (スキャンで読み取れる内容):"
    puts payload.gsub(/^/, "  ")
  else
    puts qr.as_ansi
    puts "埋め込んだデータ (スキャンで読み取れる内容):"
    puts payload.gsub(/^/, "  ")
  end
rescue QRCodeGenerator::Error => e
  warn "エラー: #{e.message}"
  warn "使い方は bin/qrcode --help を参照してください"
  exit 1
rescue OptionParser::ParseError => e
  warn "エラー: #{e.message}"
  warn parser
  exit 1
end
